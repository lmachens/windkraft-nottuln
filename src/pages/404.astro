---
import Default from '../layouts/Default.astro';
---

<Default
  title="Seite nicht gefunden – Windkraft Nottuln"
  description="Die angeforderte Seite existiert nicht."
>
  <div class="error-page">
    <div class="error-page__inner">
      <p class="error-page__code">404</p>
      <h1 class="error-page__title">Seite nicht gefunden</h1>
      <p class="error-page__text">
        Die angeforderte Seite gibt es nicht (mehr). Vielleicht hilft einer dieser Links weiter:
      </p>
      <ul class="error-page__links">
        <li><a href="/">Startseite</a></li>
        <li><a href="/faktenchecks/">Alle Faktenchecks</a></li>
        <li><a href="/faq/">Häufige Fragen</a></li>
        <li><a href="/quellen/">Quellenverzeichnis</a></li>
      </ul>
      <p class="error-page__hint">
        Falls du über einen Link hierher gekommen bist, der von <code>windkraft-nottuln.de</code> stammt:
        Bitte <a href="mailto:kontakt@windkraft-nottuln.de">kurz Bescheid geben</a>, damit ich den toten Link reparieren kann.
      </p>
    </div>
  </div>
</Default>

<style is:global>
  .error-page {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-xl) var(--space-md);
  }
  .error-page__inner {
    max-width: 540px;
    text-align: center;
  }
  .error-page__code {
    font-family: var(--font-display);
    font-size: 6rem;
    line-height: 1;
    color: var(--color-primary);
    opacity: 0.18;
    margin: 0;
    letter-spacing: -0.02em;
  }
  .error-page__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: var(--color-primary-dark);
    margin: var(--space-sm) 0 var(--space-md);
  }
  .error-page__text {
    color: var(--color-text);
    margin-bottom: var(--space-md);
  }
  .error-page__links {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-lg);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }
  .error-page__links a {
    display: inline-block;
    background: var(--color-primary-light);
    border: 1px solid var(--color-border);
    border-radius: 2rem;
    padding: 0.5rem 1.1rem;
    color: var(--color-primary-dark);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .error-page__links a:hover {
    background: var(--color-primary);
    color: #fff;
  }
  .error-page__hint {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }
  .error-page__hint code {
    font-size: 0.8125rem;
    padding: 0.05rem 0.3rem;
    background: var(--color-primary-light);
    border-radius: 3px;
  }
</style>
