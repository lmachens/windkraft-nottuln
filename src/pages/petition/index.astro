    <!-- Scroll Spy & Navigation Script -->
    <script>
    (function() {
        const sections = ['petitionstext', 'news', 'kommentare', 'argumente'];
        const sectionNames = {
            'petitionstext': 'Petitionstext',
            'news': 'News-Meldungen',
            'kommentare': 'Kommentare',
            'argumente': 'Pro & Contra'
        };

        const sidebarNav = document.querySelector('.sidebar-nav');
        const sidebarLinks = document.querySelectorAll('.sidebar-nav__link');
        const mobileButtons = document.querySelectorAll('.mobile-section-nav__btn');
        const mobileNav = document.querySelector('.mobile-section-nav');
        const mobileLabel = document.querySelector('.mobile-section-nav__label');
        const progressFill = document.querySelector('.sidebar-nav__progress-fill');

        function updateActiveSection() {
            const scrollPos = window.scrollY + 150;
            const docHeight = document.documentElement.scrollHeight - window.innerHeight;
            const scrollPercent = Math.min((window.scrollY / docHeight) * 100, 100);

            if (progressFill) {
                progressFill.style.width = scrollPercent + '%';
            }

            // Show/hide navigation based on scroll
            const showNav = window.scrollY > 500;
            if (sidebarNav) {
                sidebarNav.classList.toggle('visible', showNav);
            }
            if (mobileNav) {
                mobileNav.classList.toggle('visible', showNav);
            }

            // Find active section
            let activeSection = sections[0];
            for (const sectionId of sections) {
                const section = document.getElementById(sectionId);
                if (section && section.offsetTop <= scrollPos) {
                    activeSection = sectionId;
                }
            }

            sidebarLinks.forEach(link => {
                link.classList.toggle('active', link.dataset.section === activeSection);
            });

            mobileButtons.forEach(btn => {
                btn.classList.toggle('active', btn.dataset.section === activeSection);
            });

            if (mobileLabel) {
                mobileLabel.textContent = sectionNames[activeSection];
            }
        }

        // Throttle scroll events
        let ticking = false;
        window.addEventListener('scroll', function() {
            if (!ticking) {
                window.requestAnimationFrame(function() {
                    updateActiveSection();
                    ticking = false;
                });
                ticking = true;
            }
        });

        // Initial update
        updateActiveSection();

        // Smooth scroll for nav links
        [...sidebarLinks, ...mobileButtons].forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                const targetId = this.getAttribute('href').slice(1);
                const target = document.getElementById(targetId);
                if (target) {
                    const headerOffset = 80;
                    const elementPosition = target.getBoundingClientRect().top;
                    const offsetPosition = elementPosition + window.pageYOffset - headerOffset;

                    window.scrollTo({
                        top: offsetPosition,
                        behavior: 'smooth'
                    });
                }
            });
        });
    })();
    </script>

