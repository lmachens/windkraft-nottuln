<script>
  (function () {
    const sections = ['angebot', 'eigenschaften', 'modelle', 'rechtsrahmen', 'status'];
    const sectionNames: Record<string, string> = {
      angebot: 'Angebot',
      eigenschaften: 'Eigenschaften',
      modelle: 'Modelle',
      rechtsrahmen: 'Rechtsrahmen',
      status: 'Status',
    };

    const sidebarNav = document.querySelector<HTMLElement>('.sidebar-nav');
    const sidebarLinks = document.querySelectorAll<HTMLAnchorElement>('.sidebar-nav__link');
    const mobileButtons = document.querySelectorAll<HTMLAnchorElement>('.mobile-section-nav__btn');
    const mobileNav = document.querySelector<HTMLElement>('.mobile-section-nav');
    const mobileLabel = document.querySelector<HTMLElement>('.mobile-section-nav__label');
    const progressFill = document.querySelector<HTMLElement>('.sidebar-nav__progress-fill');

    function updateActiveSection() {
      const scrollPos = window.scrollY + 150;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const scrollPercent = docHeight > 0 ? Math.min((window.scrollY / docHeight) * 100, 100) : 0;

      if (progressFill) progressFill.style.width = scrollPercent + '%';

      const showNav = window.scrollY > 350;
      if (sidebarNav) sidebarNav.classList.toggle('visible', showNav);
      if (mobileNav) mobileNav.classList.toggle('visible', showNav);

      let activeSection = sections[0];
      for (const id of sections) {
        const el = document.getElementById(id);
        if (el && el.offsetTop <= scrollPos) activeSection = id;
      }

      sidebarLinks.forEach((link) => {
        link.classList.toggle('active', link.dataset.section === activeSection);
      });
      mobileButtons.forEach((btn) => {
        btn.classList.toggle('active', btn.dataset.section === activeSection);
      });
      if (mobileLabel) mobileLabel.textContent = sectionNames[activeSection];
    }

    let ticking = false;
    window.addEventListener('scroll', () => {
      if (ticking) return;
      window.requestAnimationFrame(() => {
        updateActiveSection();
        ticking = false;
      });
      ticking = true;
    });

    updateActiveSection();

    // Smooth-Scroll fuer Anker
    document.querySelectorAll<HTMLAnchorElement>('.sidebar-nav__link, .mobile-section-nav__btn').forEach((link) => {
      link.addEventListener('click', (e) => {
        const href = link.getAttribute('href');
        if (!href || !href.startsWith('#')) return;
        const target = document.getElementById(href.slice(1));
        if (!target) return;
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
  })();
</script>
