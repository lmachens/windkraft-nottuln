---
import { getCollection, render } from 'astro:content';
import FaktencheckLayout from '../../layouts/FaktencheckLayout.astro';
import ClaimCard from '../../components/ClaimCard.astro';

export async function getStaticPaths() {
  const entries = await getCollection('faktenchecks');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<FaktencheckLayout entry={entry}>
  <Content components={{ ClaimCard }} />
</FaktencheckLayout>
