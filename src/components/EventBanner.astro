---
export interface Props {
  /** localStorage key used to remember dismissal */
  dismissKey: string;
  /** Short label on the left (e.g. "NEU") */
  badge?: string;
  /** Link target */
  href: string;
  /** Text in front of the link */
  textBefore: string;
  /** Anchor label */
  linkLabel: string;
}

const {
  dismissKey,
  badge = 'NEU',
  href,
  textBefore,
  linkLabel,
} = Astro.props;
---

<div class="event-banner" id="eventBanner" role="alert" data-dismiss-key={dismissKey}>
  <div class="event-banner__inner">
    <span class="event-banner__date">{badge}</span>
    <span class="event-banner__text">{textBefore} <a href={href}>{linkLabel}</a></span>
    <button class="event-banner__close" aria-label="Hinweis schließen" id="eventBannerClose">&times;</button>
  </div>
</div>

<style is:global>
  .event-banner {
    background: var(--color-primary-dark);
    color: rgba(255,255,255,0.92);
    font-size: 0.875rem;
    line-height: 1.4;
    position: relative;
    z-index: 200;
    overflow: hidden;
  }
  .event-banner::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 8px,
      rgba(255,255,255,0.02) 8px,
      rgba(255,255,255,0.02) 16px
    );
    pointer-events: none;
  }
  .event-banner__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.6rem var(--space-md);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    position: relative;
  }
  .event-banner__date {
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.15);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    white-space: nowrap;
    color: #fff;
  }
  .event-banner__text { flex: 0 1 auto; }
  .event-banner__text a {
    color: #fff;
    text-decoration: underline;
    text-decoration-color: rgba(255,255,255,0.4);
    text-underline-offset: 2px;
    font-weight: 600;
    transition: text-decoration-color 0.2s;
  }
  .event-banner__text a:hover { color: #fff; text-decoration-color: #fff; }
  .event-banner__close {
    position: absolute;
    right: var(--space-md);
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: rgba(255,255,255,0.5);
    cursor: pointer;
    padding: 0.25rem;
    font-size: 1.125rem;
    line-height: 1;
    transition: color 0.2s;
  }
  .event-banner__close:hover { color: #fff; }
  .event-banner[hidden] { display: none; }
  @media (prefers-color-scheme: dark) {
    .event-banner { background: #0d2a30; color: rgba(255,255,255,0.92); }
    .event-banner__text a { color: #fff; text-decoration-color: rgba(255,255,255,0.5); }
    .event-banner__text a:hover { color: #fff; text-decoration-color: #fff; }
    .event-banner__close { color: rgba(255,255,255,0.6); }
    .event-banner__close:hover { color: #fff; }
  }
  @media (max-width: 600px) {
    .event-banner__inner { padding-right: 2.5rem; }
    .event-banner__date { display: none; }
  }
</style>

<script is:inline>
  (function () {
    var banner = document.getElementById('eventBanner');
    if (!banner) return;
    var key = banner.dataset.dismissKey;
    try { if (localStorage.getItem(key)) banner.hidden = true; } catch (e) {}
    var btn = document.getElementById('eventBannerClose');
    if (btn) btn.addEventListener('click', function () {
      banner.hidden = true;
      try { localStorage.setItem(key, '1'); } catch (e) {}
    });
  })();
</script>
