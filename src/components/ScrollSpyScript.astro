---
// Smooth-scroll, progress-bar update, active-section tracking for pages
// with <h2 id="..."> sections plus SideNav + MobileNav.
---

<script is:inline>
  (function () {
    var sections = document.querySelectorAll('h2[id]');
    var sideLinks = document.querySelectorAll('.side-nav a');
    var mobileLinks = document.querySelectorAll('.mobile-nav a');
    var progressBar = document.getElementById('progressBar');

    function addSmoothScroll(links) {
      links.forEach(function (link) {
        link.addEventListener('click', function (e) {
          e.preventDefault();
          var href = link.getAttribute('href');
          if (!href) return;
          var target = document.querySelector(href);
          if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });
    }
    addSmoothScroll(sideLinks);
    addSmoothScroll(mobileLinks);

    var ticking = false;
    window.addEventListener('scroll', function () {
      if (ticking) return;
      window.requestAnimationFrame(function () {
        var scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        var docHeight = document.documentElement.scrollHeight - window.innerHeight;
        if (progressBar) {
          progressBar.style.width =
            Math.min(docHeight > 0 ? (scrollTop / docHeight) * 100 : 0, 100) + '%';
        }

        var currentId = '';
        sections.forEach(function (s) {
          if (s.getBoundingClientRect().top <= 120) currentId = s.id;
        });
        function setActive(links) {
          links.forEach(function (l) {
            l.classList.toggle('active', l.getAttribute('href') === '#' + currentId);
          });
        }
        setActive(sideLinks);
        setActive(mobileLinks);

        ticking = false;
      });
      ticking = true;
    });
  })();
</script>
