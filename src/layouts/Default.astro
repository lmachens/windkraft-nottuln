---
export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  showProgressBar?: boolean;
}

const {
  title,
  description,
  canonical,
  ogTitle,
  ogDescription,
  showProgressBar = false,
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
---

<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="robots" content="index, follow" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="canonical" href={canonicalUrl} />
<title>{title}</title>
{description && <meta name="description" content={description} />}

<meta property="og:type" content="article" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={ogTitle ?? title} />
{(ogDescription || description) && (
  <meta property="og:description" content={ogDescription ?? description} />
)}
<meta property="og:locale" content="de_DE" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Source+Sans+3:wght@400;500;600;700&display=swap"
  rel="stylesheet"
/>

<style is:global>
  :root {
    --color-primary: #1a5f6a;
    --color-primary-dark: #134249;
    --color-primary-light: #e8f4f5;
    --color-accent: #7da87b;
    --color-text: #2d3436;
    --color-text-muted: #636e72;
    --color-bg: #fafbfc;
    --color-white: #ffffff;
    --color-border: #dfe6e9;
    --font-display: 'DM Serif Display', Georgia, serif;
    --font-body: 'Source Sans 3', -apple-system, BlinkMacSystemFont, sans-serif;
    --space-xs: 0.5rem; --space-sm: 1rem; --space-md: 1.5rem; --space-lg: 2.5rem; --space-xl: 4rem;
    --max-width: 900px;
    --border-radius: 8px;
    --shadow-sm: 0 1px 3px rgba(26,95,106,0.06);
    --shadow-md: 0 4px 12px rgba(26,95,106,0.08);
    --shadow-lg: 0 8px 30px rgba(26,95,106,0.1);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --color-primary: #5bc0cd; --color-primary-dark: #8ecfd8; --color-primary-light: #1a2e30;
      --color-accent: #9bc49a; --color-text: #e8eaed; --color-text-muted: #9aa0a6;
      --color-bg: #121518; --color-white: #1e2225; --color-border: #3c4043;
    }
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  html, body { overflow-x: hidden; }
  body { font-family: var(--font-body); font-size: 1.0625rem; line-height: 1.7; color: var(--color-text); background-color: var(--color-bg); -webkit-font-smoothing: antialiased; }
  .container { width: 100%; max-width: var(--max-width); margin: 0 auto; padding: 0 var(--space-md); }
  h1, h2, h3 { font-family: var(--font-display); font-weight: 400; line-height: 1.2; color: var(--color-primary-dark); }
  a { color: var(--color-primary); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 2px; }
  a:hover { color: var(--color-primary-dark); }

  .header { background: var(--color-white); border-bottom: 1px solid var(--color-border); padding: var(--space-sm) 0; }
  .header__inner { display: flex; justify-content: space-between; align-items: center; max-width: 1200px; margin: 0 auto; padding: 0 var(--space-md); }
  .header__logo { display: flex; align-items: center; gap: var(--space-xs); text-decoration: none; color: var(--color-primary-dark); }
  .header__logo-icon { width: 32px; height: 32px; background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent) 100%); border-radius: 50%; display: flex; align-items: center; justify-content: center; }
  .header__logo-icon svg { width: 18px; height: 18px; fill: white; }
  .header__logo-text { font-family: var(--font-display); font-size: 1.25rem; }
  .header__nav { display: flex; gap: var(--space-md); }
  .header__nav a { color: var(--color-text-muted); font-weight: 500; font-size: 0.9375rem; text-decoration: none; }
  .header__nav a:hover { color: var(--color-primary); }
  .mobile-nav-toggle { display: none; background: none; border: none; cursor: pointer; padding: var(--space-xs); }
  .mobile-nav-toggle span { display: block; width: 24px; height: 2px; background: var(--color-primary-dark); margin: 5px 0; transition: all 0.3s ease; border-radius: 2px; }
  @media (max-width: 850px) {
    .mobile-nav-toggle { display: block; }
    .header__nav { display: none; position: absolute; top: 100%; left: 0; right: 0; background: var(--color-white); flex-direction: column; padding: var(--space-md); border-bottom: 1px solid var(--color-border); box-shadow: 0 8px 24px rgba(0,0,0,0.1); gap: var(--space-sm); z-index: 100; }
    .header__nav.active { display: flex; }
    .header { position: relative; }
  }

  .content-header { background: var(--color-primary-light); border-bottom: 1px solid var(--color-border); padding: var(--space-xl) 0 var(--space-lg); text-align: center; }
  .content-header h1 { font-size: 2rem; margin-bottom: var(--space-xs); color: var(--color-primary-dark); }
  .content-header .subtitle { font-size: 1.125rem; color: var(--color-primary); margin-bottom: var(--space-md); font-weight: 500; }
  .content-header .meta { font-size: 0.875rem; color: var(--color-text-muted); max-width: 680px; margin: 0 auto; line-height: 1.6; }
  .content-header .meta strong { color: var(--color-primary-dark); font-weight: 600; }
  .content { max-width: 780px; margin: 0 auto; padding: 0 var(--space-md); }
  .intro-note { background: var(--color-primary-light); border: 1px solid var(--color-border); border-left: 4px solid var(--color-primary); padding: 18px 22px; margin: 36px 0; font-size: 0.9375rem; color: var(--color-text-muted); border-radius: var(--border-radius); }
  h2 { font-size: 1.5rem; color: var(--color-primary-dark); margin: var(--space-xl) 0 var(--space-sm); padding-bottom: 10px; border-bottom: 2px solid var(--color-primary); scroll-margin-top: 20px; }
  h3 { font-size: 1.125rem; color: var(--color-primary-dark); margin: var(--space-md) 0 var(--space-xs); }
  p { margin-bottom: var(--space-sm); }
  ul, ol { margin: var(--space-xs) 0 var(--space-sm) var(--space-md); }
  li { margin-bottom: 4px; }
  table { border-collapse: collapse; width: 100%; margin: 14px 0; font-size: 0.9375rem; background: var(--color-white); border-radius: var(--border-radius); overflow: hidden; box-shadow: var(--shadow-sm); }
  th, td { border-bottom: 1px solid var(--color-border); padding: 10px 14px; text-align: left; vertical-align: top; }
  td { border-right: 1px solid var(--color-border); } td:last-child { border-right: none; }
  th { background: var(--color-primary-dark); color: rgba(255,255,255,0.95); font-weight: 500; font-size: 0.75rem; letter-spacing: 0.6px; text-transform: uppercase; padding: 11px 14px; }
  tr:last-child td { border-bottom: none; } tr:hover td { background: rgba(232,244,245,0.4); }
  blockquote { position: relative; margin: 18px 0; padding: 18px 22px 18px 24px; background: var(--color-primary-light); border: 1px solid var(--color-border); border-left: 4px solid var(--color-primary); border-radius: 0 var(--border-radius) var(--border-radius) 0; font-family: var(--font-display); font-size: 0.9375rem; font-style: italic; color: var(--color-text); line-height: 1.65; }
  blockquote::before { content: '\201E'; position: absolute; top: 8px; left: 8px; font-size: 28px; color: var(--color-primary); opacity: 0.4; font-family: Georgia, serif; line-height: 1; }

  .claim-card { background: var(--color-white); border: 1px solid var(--color-border); border-left: 4px solid var(--color-accent); border-radius: var(--border-radius); padding: 24px 26px; margin: 24px 0; box-shadow: var(--shadow-sm); }
  .claim-card h3 { margin-top: 0; }
  .bewertung { display: inline-block; padding: 5px 11px; border-radius: 4px; font-family: var(--font-body); font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.4px; margin: 8px 0 14px; }
  .bewertung-rot { background: rgba(220, 53, 69, 0.1); color: #b02438; border: 1px solid rgba(220, 53, 69, 0.25); }
  .bewertung-gelb { background: rgba(245, 158, 11, 0.1); color: #b76e0a; border: 1px solid rgba(245, 158, 11, 0.25); }
  .bewertung-grau { background: rgba(99, 110, 114, 0.1); color: #4b5557; border: 1px solid rgba(99, 110, 114, 0.25); }
  .source { font-size: 0.8125rem; color: var(--color-text-muted); margin-top: 14px; padding-top: 12px; border-top: 1px dashed var(--color-border); line-height: 1.6; }
  .source a { color: var(--color-primary); }

  .footer { background: var(--color-white); border-top: 1px solid var(--color-border); padding: var(--space-xl) 0 var(--space-lg); }
  .footer__inner { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: var(--space-lg); max-width: var(--max-width); margin: 0 auto; padding: 0 var(--space-md); }
  @media (max-width: 768px) { .footer__inner { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 480px) { .footer__inner { grid-template-columns: 1fr; } }
  .footer__brand p { color: var(--color-text-muted); font-size: 0.9375rem; margin-top: var(--space-sm); }
  .footer__col h4 { font-family: var(--font-body); font-weight: 600; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-primary-dark); margin-bottom: var(--space-sm); }
  .footer__col ul { list-style: none; padding-left: 0; margin: 0; }
  .footer__col li { margin-bottom: var(--space-xs); }
  .footer__col a { color: var(--color-text); text-decoration: none; font-size: 0.9375rem; }
  .footer__col a:hover { color: var(--color-primary); }
  .footer__bottom { max-width: var(--max-width); margin: var(--space-xl) auto 0; padding: var(--space-md) var(--space-md) 0; border-top: 1px solid var(--color-border); text-align: center; }
  .footer__bottom p { color: var(--color-text-muted); font-size: 0.875rem; margin: 0; }

  .progress-bar { position: fixed; top: 0; left: 0; width: 0%; height: 3px; background: linear-gradient(90deg, var(--color-primary), var(--color-accent), var(--color-primary-dark)); z-index: 1001; transition: width 0.15s linear; }

  .side-nav {
    position: fixed; top: 50%; left: 16px; transform: translateY(-50%);
    width: 220px; background: var(--color-white); border: 1px solid var(--color-border);
    padding: 18px 0; z-index: 1000; border-radius: var(--border-radius); box-shadow: var(--shadow-lg);
  }
  .side-nav-title {
    font-family: var(--font-body); font-size: 0.625rem; letter-spacing: 2.5px;
    text-transform: uppercase; color: var(--color-text-muted); font-weight: 700;
    padding: 0 18px 12px; border-bottom: 1px solid var(--color-border); margin-bottom: 6px;
  }
  .side-nav a {
    display: block; padding: 7px 18px; font-family: var(--font-body); font-size: 0.8125rem;
    color: var(--color-text-muted); text-decoration: none; border-left: 3px solid transparent;
    transition: all 0.2s ease; line-height: 1.4;
  }
  .side-nav a:hover { color: var(--color-text); background: var(--color-primary-light); text-decoration: none; }
  .side-nav a.active { color: var(--color-primary); font-weight: 600; border-left-color: var(--color-primary); background: var(--color-primary-light); }
  @media (min-width: 1180px) {
    .content { margin-left: calc((100% - 780px) / 2 + 50px); margin-right: auto; }
  }

  .mobile-nav {
    display: none; position: fixed; bottom: 14px; left: 50%; transform: translateX(-50%);
    background: var(--color-white); border: 1px solid var(--color-border); padding: 5px 6px;
    border-radius: 22px; z-index: 1000; box-shadow: var(--shadow-lg); white-space: nowrap;
    overflow-x: auto; max-width: 94vw; -webkit-overflow-scrolling: touch; scrollbar-width: none;
  }
  .mobile-nav::-webkit-scrollbar { display: none; }
  .mobile-nav a {
    display: inline-block; padding: 6px 11px; font-family: var(--font-body); font-size: 0.75rem;
    color: var(--color-text-muted); text-decoration: none; border-radius: 14px;
    transition: all 0.2s ease; font-weight: 500;
  }
  .mobile-nav a:hover { color: var(--color-text); background: var(--color-primary-light); text-decoration: none; }
  .mobile-nav a.active { background: var(--color-primary); color: #fff; font-weight: 600; }

  @media print {
    .header, .footer, .side-nav, .mobile-nav, .progress-bar { display: none !important; }
    .claim-card { break-inside: avoid; box-shadow: none; border: 1px solid #bbb; }
    body { font-size: 12px; background: #fff; }
    .content { margin-left: auto !important; max-width: 100%; }
    a { color: #333; }
  }
  @media (max-width: 600px) {
    .content-header { padding: var(--space-lg) 0 var(--space-md); }
    .content-header h1 { font-size: 1.5rem; }
    .content { padding: 0 18px; }
    .claim-card { padding: 20px 18px; margin: 18px 0; }
  }
  @media (max-width: 1179px) {
    .side-nav { display: none; }
    .mobile-nav { display: block; }
  }
  @media (min-width: 1180px) {
    .side-nav { display: block; }
    .mobile-nav { display: none; }
  }
</style>

<script async src="https://metrics.th.gl/js/pa-tT1oTBaakBaf8SIoAGQdW.js"></script>
<script is:inline>
  window.plausible = window.plausible || function () { (plausible.q = plausible.q || []).push(arguments); };
  plausible.init = plausible.init || function (i) { plausible.o = i || {}; };
  plausible.init();
</script>
</head>
<body>

{showProgressBar && <div class="progress-bar" id="progressBar"></div>}

<header class="header">
  <div class="header__inner">
    <a href="/" class="header__logo">
      <div class="header__logo-icon">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M10.5 12L10 24H14L13.5 12" fill="white" opacity="0.7"/>
          <circle cx="12" cy="10.5" r="2.25" fill="white"/>
          <path d="M10.5 9L12 0L13.5 9Z" fill="white"/>
          <path d="M12 9L24 17L12 12Z" fill="white"/>
          <path d="M12 9L0 17L12 12Z" fill="white"/>
        </svg>
      </div>
      <span class="header__logo-text">Windkraft Nottuln</span>
    </a>
    <button
      class="mobile-nav-toggle"
      aria-label="Menü öffnen"
      onclick="this.classList.toggle('active'); document.querySelector('.header__nav').classList.toggle('active');"
    >
      <span></span><span></span><span></span>
    </button>
    <nav class="header__nav">
      <a href="/">Startseite</a>
      <a href="/anlagen/">Anlagen</a>
      <a href="/hauswert/">Hauswert</a>
      <a href="/petition/">Petition</a>
      <a href="/faq/">FAQ</a>
      <a href="/gesetze/">Gesetze</a>
      <a href="/quellen/">Quellen</a>
    </nav>
  </div>
</header>

<slot />

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__brand">
      <a href="/" class="header__logo">
        <div class="header__logo-icon">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M10.5 12L10 24H14L13.5 12" fill="white" opacity="0.7"/>
            <circle cx="12" cy="10.5" r="2.25" fill="white"/>
            <path d="M10.5 9L12 0L13.5 9Z" fill="white"/>
            <path d="M12 9L24 17L12 12Z" fill="white"/>
            <path d="M12 9L0 17L12 12Z" fill="white"/>
          </svg>
        </div>
        <span class="header__logo-text">Windkraft Nottuln</span>
      </a>
      <p>Faktencheck zur Windkraft-Debatte in Nottuln. Quellenbasiert, transparent, ohne Pauschalurteile.</p>
    </div>
    <div class="footer__col">
      <h4>Inhalte</h4>
      <ul>
        <li><a href="/">Startseite</a></li>
        <li><a href="/anlagen/">Anlagen</a></li>
        <li><a href="/hauswert/">Hauswert</a></li>
        <li><a href="/faq/">Häufige Fragen</a></li>
        <li><a href="/gesetze/">Gesetze &amp; Verfahren</a></li>
        <li><a href="/quellen/">Quellenverzeichnis</a></li>
      </ul>
    </div>
    <div class="footer__col">
      <h4>Externe Quellen</h4>
      <ul>
        <li><a href="https://www.bund.net/themen/aktuelles/detail-aktuelles/news/argumente-fuer-windenergie-fakten-statt-mythen/" target="_blank" rel="noopener">BUND Faktencheck</a></li>
        <li><a href="https://www.umweltbundesamt.de" target="_blank" rel="noopener">Umweltbundesamt</a></li>
        <li><a href="https://www.nottuln.de/leben-in-nottuln/klimaschutz-energie-umwelt/windenergie-nottuln" target="_blank" rel="noopener">Gemeinde Nottuln</a></li>
      </ul>
    </div>
    <div class="footer__col">
      <h4>Rechtliches</h4>
      <ul>
        <li><a href="/impressum/">Impressum</a></li>
        <li><a href="/datenschutz/">Datenschutz</a></li>
        <li><a href="https://github.com/lmachens/windkraft-nottuln" target="_blank" rel="noopener">GitHub (Open Source)</a></li>
      </ul>
    </div>
  </div>
  <div class="footer__bottom">
    <p>&copy; 2026 Windkraft Nottuln &middot; <a href="https://github.com/lmachens/windkraft-nottuln/blob/main/LICENSE" target="_blank" rel="noopener" style="color: inherit;">MIT-Lizenz</a></p>
  </div>
</footer>

<slot name="after-body" />

</body>
</html>
