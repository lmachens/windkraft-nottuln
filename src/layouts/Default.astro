---
import { Font } from 'astro:assets';
import EventBanner from '../components/EventBanner.astro';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  showProgressBar?: boolean;
  showHomeLink?: boolean;
}

const {
  title,
  description,
  canonical,
  ogTitle,
  ogDescription,
  ogImage,
  showProgressBar = false,
  showHomeLink = true,
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = ogImage ?? 'https://windkraft-nottuln.de/og/default.png';
---

<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="robots" content="index, follow" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="canonical" href={canonicalUrl} />
<title>{title}</title>
{description && <meta name="description" content={description} />}

<meta property="og:type" content="article" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={ogTitle ?? title} />
{(ogDescription || description) && (
  <meta property="og:description" content={ogDescription ?? description} />
)}
<meta property="og:locale" content="de_DE" />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImageUrl} />

<Font cssVariable="--font-display" preload />
<Font cssVariable="--font-body" preload />

<slot name="head-extras" />

<style is:global>
  :root {
    --color-primary: #1a5f6a;
    --color-primary-dark: #134249;
    --color-primary-light: #e8f4f5;
    --color-accent: #7da87b;
    --color-text: #2d3436;
    --color-text-muted: #636e72;
    --color-bg: #fafbfc;
    --color-white: #ffffff;
    --color-border: #dfe6e9;
    --space-xs: 0.5rem; --space-sm: 1rem; --space-md: 1.5rem; --space-lg: 2.5rem; --space-xl: 4rem;
    --border-radius: 8px;
    --shadow-sm: 0 1px 3px rgba(26,95,106,0.06);
    --shadow-md: 0 4px 12px rgba(26,95,106,0.08);
    --shadow-lg: 0 8px 30px rgba(26,95,106,0.1);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --color-primary: #5bc0cd; --color-primary-dark: #8ecfd8; --color-primary-light: #1a2e30;
      --color-accent: #9bc49a; --color-text: #e8eaed; --color-text-muted: #9aa0a6;
      --color-bg: #121518; --color-white: #1e2225; --color-border: #3c4043;
    }
  }
  /* Default fuer Pages ohne eigene --max-width-Deklaration (z.B. Faktenchecks,
     Suche, 404). Wird per :where mit Spezifitaet 0 deklariert, damit Page-CSS,
     das nach diesem Layout-CSS geladen wird, aber gleiche Spezifitaet hat,
     verlaesslich gewinnt. */
  :where(:root) {
    --max-width: 900px;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  html, body { overflow-x: hidden; }
  body { font-family: var(--font-body); font-size: 1.0625rem; line-height: 1.7; color: var(--color-text); background-color: var(--color-bg); -webkit-font-smoothing: antialiased; }
  .container { width: 100%; max-width: var(--max-width); margin: 0 auto; padding: 0 var(--space-md); }
  h1, h2, h3 { font-family: var(--font-display); font-weight: 400; line-height: 1.2; color: var(--color-primary-dark); }
  a { color: var(--color-primary); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 2px; }
  a:hover { color: var(--color-primary-dark); }

  .header { background: var(--color-white); border-bottom: 1px solid var(--color-border); padding: var(--space-sm) 0; }
  .header__inner { display: flex; justify-content: space-between; align-items: center; max-width: 1200px; margin: 0 auto; padding: 0 var(--space-md); }
  .header__logo { display: flex; align-items: center; gap: var(--space-xs); text-decoration: none; color: var(--color-primary-dark); flex-shrink: 0; }
  .header__logo-icon { width: 32px; height: 32px; background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent) 100%); border-radius: 50%; display: flex; align-items: center; justify-content: center; }
  .header__logo-icon svg { width: 18px; height: 18px; fill: white; }
  .header__logo-text { font-family: var(--font-display); font-size: 1.25rem; white-space: nowrap; }
  .header__nav { display: flex; gap: var(--space-md); }
  .header__nav a { color: var(--color-text-muted); font-weight: 500; font-size: 0.9375rem; text-decoration: none; }
  .header__nav a:hover { color: var(--color-primary); }
  .header__search { display: inline-flex; align-items: center; gap: 0.35rem; }
  .header__search svg { stroke: currentColor; }
  @media (min-width: 1151px) {
    .header__search-label { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  }
  .mobile-nav-toggle { display: none; background: none; border: none; cursor: pointer; padding: var(--space-xs); }
  .mobile-nav-toggle span { display: block; width: 24px; height: 2px; background: var(--color-primary-dark); margin: 5px 0; transition: all 0.3s ease; border-radius: 2px; }
  @media (max-width: 1150px) {
    .mobile-nav-toggle { display: block; }
    .header__nav { display: none; position: absolute; top: 100%; left: 0; right: 0; background: var(--color-white); flex-direction: column; padding: var(--space-md); border-bottom: 1px solid var(--color-border); box-shadow: 0 8px 24px rgba(0,0,0,0.1); gap: var(--space-sm); z-index: 100; }
    .header__nav.active { display: flex; }
    .header { position: relative; }
  }

  .footer { background: var(--color-white); border-top: 1px solid var(--color-border); padding: var(--space-xl) 0 var(--space-lg); }
  .footer__inner { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: var(--space-lg); max-width: var(--max-width); margin: 0 auto; padding: 0 var(--space-md); }
  @media (max-width: 768px) { .footer__inner { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 480px) { .footer__inner { grid-template-columns: 1fr; } }
  .footer__brand p { color: var(--color-text-muted); font-size: 0.9375rem; margin-top: var(--space-sm); }
  .footer__col-title { font-family: var(--font-body); font-weight: 600; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-primary-dark); margin-bottom: var(--space-sm); }
  .footer__col ul { list-style: none; padding-left: 0; margin: 0; }
  .footer__col li { margin-bottom: var(--space-xs); }
  .footer__col a { color: var(--color-text); text-decoration: none; font-size: 0.9375rem; }
  .footer__col a:hover { color: var(--color-primary); }
  .footer__bottom { max-width: var(--max-width); margin: var(--space-xl) auto 0; padding: var(--space-md) var(--space-md) 0; border-top: 1px solid var(--color-border); text-align: center; }
  .footer__bottom p { color: var(--color-text-muted); font-size: 0.875rem; margin: 0; }

  /* Skip-to-content link (visible only when focused) */
  .skip-link {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%) translateY(-150%);
    z-index: 10000;
    padding: 0.75rem 1.25rem;
    background: var(--color-primary-dark);
    color: #fff;
    border-radius: 0 0 var(--border-radius) var(--border-radius);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: transform 0.15s ease;
  }
  .skip-link:focus {
    transform: translateX(-50%) translateY(0);
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  @media print {
    @page { margin: 1.6cm 1.4cm 1.8cm 1.4cm; }
    .header, .footer, .skip-link,
    .event-banner, .breadcrumbs { display: none !important; }
    body { font-size: 10pt; background: #fff; color: #000; }
    main { display: block !important; }
    a { color: #000; text-decoration: underline; }
    h1, h2, h3, h4 { color: #000; page-break-after: avoid; }
    img, table, blockquote, figure { page-break-inside: avoid; }
  }
</style>

<script async src="/js/stats.js"></script>
<script is:inline>
  window.plausible = window.plausible || function () { (plausible.q = plausible.q || []).push(arguments); };
  plausible.init = plausible.init || function (i) { plausible.o = i || {}; };
  plausible.init();
</script>
</head>
<body>

<a href="#main-content" class="skip-link">Zum Hauptinhalt springen</a>

{showProgressBar && <div class="progress-bar" id="progressBar"></div>}

<slot name="before-header">
  <EventBanner
    dismissKey="banner-vahl-mainz-dismissed"
    href="/dokumentation/faktencheck-vahl-mainz-2026.html"
    textBefore={'Neu: Faktencheck zur „Mainzer Studie" —'}
    linkLabel="DGIM-Kongressposter geprüft"
  />
</slot>

<header class="header">
  <div class="header__inner">
    <a href="/" class="header__logo">
      <div class="header__logo-icon">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M10.5 12L10 24H14L13.5 12" fill="white" opacity="0.7"/>
          <circle cx="12" cy="10.5" r="2.25" fill="white"/>
          <path d="M10.5 9L12 0L13.5 9Z" fill="white"/>
          <path d="M12 9L24 17L12 12Z" fill="white"/>
          <path d="M12 9L0 17L12 12Z" fill="white"/>
        </svg>
      </div>
      <span class="header__logo-text">Windkraft Nottuln</span>
    </a>
    <button
      class="mobile-nav-toggle"
      aria-label="Menü öffnen"
      onclick="this.classList.toggle('active'); document.querySelector('.header__nav').classList.toggle('active');"
    >
      <span></span><span></span><span></span>
    </button>
    <nav class="header__nav">
      <slot name="nav-extra" />
      {showHomeLink && <a href="/">Startseite</a>}
      <a href="/faktenchecks/">Faktenchecks</a>
      <a href="/anlagen/">Anlagen</a>
      <a href="/hauswert/">Hauswert</a>
      <a href="/betroffenheit/">Betroffenheit</a>
      <a href="/buergerbeteiligung/">Beteiligung</a>
      <a href="/petition/">Petition</a>
      <a href="/faq/">FAQ</a>
      <a href="/gesetze/">Gesetze</a>
      <a href="/quellen/">Quellen</a>
      <a href="/suche/" class="header__search" aria-label="Seite durchsuchen">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <span class="header__search-label">Suche</span>
      </a>
    </nav>
  </div>
</header>

<main id="main-content">
  <slot />
</main>

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__brand">
      <a href="/" class="header__logo">
        <div class="header__logo-icon">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M10.5 12L10 24H14L13.5 12" fill="white" opacity="0.7"/>
            <circle cx="12" cy="10.5" r="2.25" fill="white"/>
            <path d="M10.5 9L12 0L13.5 9Z" fill="white"/>
            <path d="M12 9L24 17L12 12Z" fill="white"/>
            <path d="M12 9L0 17L12 12Z" fill="white"/>
          </svg>
        </div>
        <span class="header__logo-text">Windkraft Nottuln</span>
      </a>
      <p>Eine private Initiative für mehr Fakten zur Windenergie in Nottuln, Kreis Coesfeld. Nicht gesponsert, nicht parteiisch.</p>
    </div>
    <div class="footer__col">
      <p class="footer__col-title">Inhalte</p>
      <ul>
        <li><a href="/">Startseite</a></li>
        <li><a href="/faktenchecks/">Faktenchecks</a></li>
        <li><a href="/anlagen/">Anlagen</a></li>
        <li><a href="/hauswert/">Hauswert</a></li>
        <li><a href="/betroffenheit/">Betroffenheit ernst nehmen</a></li>
        <li><a href="/buergerbeteiligung/">Bürgerbeteiligung</a></li>
        <li><a href="/faq/">Häufige Fragen</a></li>
        <li><a href="/gesetze/">Gesetze &amp; Verfahren</a></li>
        <li><a href="/quellen/">Quellenverzeichnis</a></li>
        <li><a href="/suche/">Suche</a></li>
      </ul>
    </div>
    <div class="footer__col">
      <p class="footer__col-title">Externe Quellen</p>
      <ul>
        <li><a href="https://www.bund.net/themen/aktuelles/detail-aktuelles/news/argumente-fuer-windenergie-fakten-statt-mythen/" target="_blank" rel="noopener">BUND Faktencheck</a></li>
        <li><a href="https://www.umweltbundesamt.de" target="_blank" rel="noopener">Umweltbundesamt</a></li>
        <li><a href="https://www.nottuln.de/leben-in-nottuln/klimaschutz-energie-umwelt/windenergie-nottuln" target="_blank" rel="noopener">Gemeinde Nottuln</a></li>
      </ul>
    </div>
    <div class="footer__col">
      <p class="footer__col-title">Rechtliches</p>
      <ul>
        <li><a href="/impressum/">Impressum</a></li>
        <li><a href="/datenschutz/">Datenschutz</a></li>
        <li><a href="https://github.com/lmachens/windkraft-nottuln" target="_blank" rel="noopener">GitHub (Open Source)</a></li>
      </ul>
    </div>
  </div>
  <div class="footer__bottom">
    <p>&copy; 2026 Windkraft Nottuln &middot; <a href="https://github.com/lmachens/windkraft-nottuln/blob/main/LICENSE" target="_blank" rel="noopener" style="color: inherit;">MIT-Lizenz</a></p>
  </div>
</footer>

<slot name="after-body" />

</body>
</html>
